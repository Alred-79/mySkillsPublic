From a1b2c3d4e5f60718293a4b5c6d7e8f9012345678 Mon Sep 17 00:00:00 2001
From: Dev <dev@example.com>
Date: Tue, 21 Jul 2026 10:00:00 +0000
Subject: [PATCH] Clamp discount so checkout totals can no longer go negative

An out-of-range discount percentage could push a checkout total below zero.
Clamping the percentage into [0, 100] and rounding to cents makes checkout
totals safe.
---
 pricing.py | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/pricing.py b/pricing.py
index 1111111..2222222 100644
--- a/pricing.py
+++ b/pricing.py
@@ -1,6 +1,12 @@
 """Pricing helpers for the checkout service."""


 def apply_discount(price, pct):
-    """Apply a percentage discount to a price."""
-    return price * (1.0 - pct / 100.0)
+    """Apply a percentage discount to a price.
+
+    pct is clamped to [0, 100] so an out-of-range percentage can never
+    produce a negative or inflated total. The result is rounded to cents.
+    """
+    pct = max(0.0, min(100.0, pct))
+    discounted = price * (1.0 - pct / 100.0)
+    return round(discounted, 2)
--
2.40.0
