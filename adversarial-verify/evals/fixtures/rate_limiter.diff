+"""Per-client token-bucket rate limiter for the ingest API."""
+import threading
+import time
+
+
+class TokenBucket:
+    def __init__(self, capacity: int, refill_rate: float):
+        # capacity: max tokens the bucket can hold (burst size)
+        # refill_rate: tokens added per second
+        self.capacity = capacity
+        self.refill_rate = refill_rate
+        self.tokens = float(capacity)
+        self._last = time.monotonic()
+        self._lock = threading.Lock()
+
+    def _refill(self) -> None:
+        now = time.monotonic()
+        elapsed = now - self._last
+        self.tokens = min(self.capacity, self.tokens + elapsed * self.refill_rate)
+        self._last = now
+
+    def allow(self, cost: int = 1) -> bool:
+        """Return True and consume `cost` tokens if available, else False."""
+        with self._lock:
+            self._refill()
+            if self.tokens >= cost:
+                self.tokens -= cost
+                return True
+            return False
+
+
+class RateLimiter:
+    """Holds one bucket per client id."""
+
+    def __init__(self, capacity: int = 10, refill_rate: float = 5.0):
+        self.capacity = capacity
+        self.refill_rate = refill_rate
+        self._buckets = {}
+        self._lock = threading.Lock()
+
+    def _bucket_for(self, client_id: str) -> TokenBucket:
+        # PLANTED BUG (B1): this read-then-write is not inside self._lock.
+        # Two threads for a new client_id both see a miss and each create a
+        # bucket; the second overwrites the first, resetting tokens to full.
+        # A client can exceed its limit by racing concurrent first requests.
+        if client_id not in self._buckets:
+            self._buckets[client_id] = TokenBucket(self.capacity, self.refill_rate)
+        return self._buckets[client_id]
+
+    def allow(self, client_id: str, cost: int = 1) -> bool:
+        bucket = self._bucket_for(client_id)
+        return bucket.allow(cost)
